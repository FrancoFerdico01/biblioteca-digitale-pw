# Copia questo file in .env e imposta i valori reali (il file .env non va committato)

# Account amministratore unico, creato/aggiornato all'avvio del backend
ADMIN_EMAIL=admin@bibliotecadigitale.it
ADMIN_PASSWORD=cambia-questa-password

# Chiave per firmare i token JWT (generane una lunga e casuale)
SECRET_KEY=cambia-questa-chiave
